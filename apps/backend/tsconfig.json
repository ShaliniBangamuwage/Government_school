{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "types": ["node", "jest"],
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@edunexa/shared-types": ["../../packages/shared-types/src"],
      "@edunexa/shared-validation": ["../../packages/shared-validation/src"],
      "@edunexa/shared-constants": ["../../packages/shared-constants/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}

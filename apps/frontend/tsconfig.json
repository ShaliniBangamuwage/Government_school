{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "plugins": [{ "name": "next" }],
    "types": ["vitest/globals"],
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@edunexa/shared-types": ["../../packages/shared-types/src"],
      "@edunexa/shared-validation": ["../../packages/shared-validation/src"],
      "@edunexa/shared-constants": ["../../packages/shared-constants/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": false,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@edunexa/shared-types": ["packages/shared-types/src"],
      "@edunexa/shared-validation": ["packages/shared-validation/src"],
      "@edunexa/shared-constants": ["packages/shared-constants/src"],
      "@/*": ["apps/frontend/src/*"]
    }
  }
}
